{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CP: Compile & Run",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/C",
                    "g++ \"${file}\" -std=c++20 -Wall -Wextra -Wshadow -fdiagnostics-color=always -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\" < \"${fileDirname}\\input.txt\" > \"${fileDirname}\\output.txt\" & exit 0"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "focus": false,
                "clear": true,
                "echo": false,
                "showReuseMessage": false
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}